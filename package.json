    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "prettier": "^2.7.1",
    "rimraf": "^3.0.2",
    "turbo": "^2.8.14",
    "typescript": "^4.9.3"
  }
}
